{"timestamp": "2025-12-06T21:20:15.984423", "script": "logging_utils.py", "script_path": "/private/var/tmp/_bazel_vyakunin/c11e7c4a7a663c4f29287067808714fc/execroot/_main/bazel-out/darwin_arm64-fastbuild/bin/explore_db.runfiles/_main/lib/utils/logging_utils.py", "args": {"query": "\nSELECT \n    COUNT(*) as overlap_count\nFROM (\n    SELECT case_number \n    FROM salary_record \n    WHERE (source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%')\n    INTERSECT\n    SELECT case_number \n    FROM salary_record \n    WHERE NOT (source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%')\n);", "arg_2": "\nSELECT \n    COUNT(*) as overlap_count\nFROM (\n    SELECT case_number \n    FROM salary_record \n    WHERE (source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%')\n    INTERSECT\n    SELECT case_number \n    FROM salary_record \n    WHERE NOT (source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%')\n);"}, "context": "No context provided"}
{"timestamp": "2025-12-06T21:20:18.758086", "script": "logging_utils.py", "script_path": "/private/var/tmp/_bazel_vyakunin/c11e7c4a7a663c4f29287067808714fc/execroot/_main/bazel-out/darwin_arm64-fastbuild/bin/explore_db.runfiles/_main/lib/utils/logging_utils.py", "args": {"query": "\nSELECT \n    w.case_number,\n    w.source_file as worksite_file,\n    r.source_file as regular_file,\n    w.employer_name as worksite_employer,\n    r.employer_name as regular_employer\nFROM salary_record w\nJOIN salary_record r ON w.case_number = r.case_number\nWHERE (w.source_file LIKE '%worksite%' OR w.source_file LIKE '%Worksite%')\n  AND NOT (r.source_file LIKE '%worksite%' OR r.source_file LIKE '%Worksite%')\nLIMIT 10;", "\nSELECT \n    w.case_number,\n    w.source_file as worksite_file,\n    r.source_file as regular_file,\n    w.employer_name as worksite_employer,\n    r.employer_name as regular_employer\nFROM salary_record w\nJOIN salary_record r ON w.case_number ": " r.case_number\nWHERE (w.source_file LIKE '%worksite%' OR w.source_file LIKE '%Worksite%')\n  AND NOT (r.source_file LIKE '%worksite%' OR r.source_file LIKE '%Worksite%')\nLIMIT 10;"}, "context": "No context provided"}
{"timestamp": "2025-12-06T21:22:20.580009", "script": "logging_utils.py", "script_path": "/private/var/tmp/_bazel_vyakunin/c11e7c4a7a663c4f29287067808714fc/execroot/_main/bazel-out/darwin_arm64-fastbuild/bin/explore_db.runfiles/_main/lib/utils/logging_utils.py", "args": {"query": "\nSELECT \n    CASE \n        WHEN source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%' THEN 'worksite'\n        ELSE 'regular'\n    END as file_type,\n    COUNT(*) as record_count,\n    COUNT(DISTINCT case_number) as unique_cases,\n    MIN(LENGTH(case_number)) as min_case_length,\n    MAX(LENGTH(case_number)) as max_case_length,\n    SUBSTR(case_number, 1, 5) as case_prefix_sample\nFROM salary_record\nGROUP BY file_type\nLIMIT 5;", "arg_2": "\nSELECT \n    CASE \n        WHEN source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%' THEN 'worksite'\n        ELSE 'regular'\n    END as file_type,\n    COUNT(*) as record_count,\n    COUNT(DISTINCT case_number) as unique_cases,\n    MIN(LENGTH(case_number)) as min_case_length,\n    MAX(LENGTH(case_number)) as max_case_length,\n    SUBSTR(case_number, 1, 5) as case_prefix_sample\nFROM salary_record\nGROUP BY file_type\nLIMIT 5;"}, "context": "No context provided"}
{"timestamp": "2025-12-06T21:22:22.886616", "script": "logging_utils.py", "script_path": "/private/var/tmp/_bazel_vyakunin/c11e7c4a7a663c4f29287067808714fc/execroot/_main/bazel-out/darwin_arm64-fastbuild/bin/explore_db.runfiles/_main/lib/utils/logging_utils.py", "args": {"query": "\nSELECT \n    CASE \n        WHEN source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%' THEN 'worksite'\n        ELSE 'regular'\n    END as file_type,\n    COUNT(DISTINCT case_number) as unique_cases,\n    COUNT(*) as total_records,\n    COUNT(*) - COUNT(DISTINCT case_number) as duplicate_cases\nFROM salary_record\nGROUP BY file_type;", "arg_2": "\nSELECT \n    CASE \n        WHEN source_file LIKE '%worksite%' OR source_file LIKE '%Worksite%' THEN 'worksite'\n        ELSE 'regular'\n    END as file_type,\n    COUNT(DISTINCT case_number) as unique_cases,\n    COUNT(*) as total_records,\n    COUNT(*) - COUNT(DISTINCT case_number) as duplicate_cases\nFROM salary_record\nGROUP BY file_type;"}, "context": "No context provided"}
