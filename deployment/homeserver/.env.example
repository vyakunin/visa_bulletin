# Copy to /opt/stack/visa_bulletin/.env on the homeserver, fill in secrets, then
# `chmod 600 .env`. NEVER commit the populated file — this repo is public.

# Postgres (must match what's already inside ./postgres-data/ from a restored backup)
DB_NAME=visa_bulletin
DB_USER=visa_bulletin_user
DB_PASSWORD=__set_me__

# Django
DJANGO_SECRET_KEY=__generate_50_random_chars__
ALLOWED_HOSTS=localhost,127.0.0.1,homeserver.local,192.168.1.152,visa-bulletin.us,www.visa-bulletin.us,staging.visa-bulletin.us

# Cloudflare tunnel — token comes from `~/tokens/cloudflare_tunnel_homeserver` on the Mac
# (or Cloudflare Zero Trust dashboard → Networks → Tunnels → homeserver → token).
CF_TUNNEL_TOKEN=__set_me__

# Optional. The GoatCounter analytics snippet that gets injected into <head>.
ANALYTICS_SCRIPT=<script data-goatcounter="https://vyakunin.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>

# Gunicorn workers — 3 fits comfortably in the 8 GB box; raise carefully.
WEB_CONCURRENCY=3
