# Bazel module for Visa Bulletin Parser

module(
    name = "visa_bulletin",
    version = "1.0.0",
)

# Python rules
bazel_dep(name = "rules_python", version = "0.40.0")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "visa_bulletin_pip",
    python_version = "3.11",
    requirements_lock = "//:requirements.lock",
)

use_repo(pip, "visa_bulletin_pip")

# Homebrew package manager dependency - automatically installs if missing
homebrew = use_extension("//tools:homebrew.bzl", "homebrew_extension")
use_repo(homebrew, "homebrew")

# Ollama LLM dependency - hermetic version (downloads binary and manages models in Bazel cache)
# Using platform-specific repositories with select() for cross-platform support
# Note: Ollama releases single binary files (not tarballs), so we use http_file instead of http_archive
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Ollama v0.5.5 for macOS (universal binary - works on both Intel and Apple Silicon)
http_file(
    name = "ollama_platform_macos_arm64",
    urls = ["https://github.com/ollama/ollama/releases/download/v0.5.5/ollama-darwin"],
    sha256 = "3e282de57e03baf940ba87bc3af600602c65d9b4d037de0ab0360a1395e3e8ed",
    downloaded_file_path = "ollama_bin",
    executable = True,
)

# Ollama v0.5.5 for Linux (AMD64/x86_64)
http_file(
    name = "ollama_platform_linux_x86_64",
    urls = ["https://github.com/ollama/ollama/releases/download/v0.5.5/ollama-linux-amd64"],
    sha256 = "614e78776e76ff28d8b9305d09cd81638241c6e2ae546891f4a76d100ed1e746",
    downloaded_file_path = "ollama_bin",
    executable = True,
)

# Ollama v0.5.5 for Linux (ARM64)
# Note: SHA256 needs to be updated once we get it from GitHub releases
http_file(
    name = "ollama_platform_linux_arm64",
    urls = ["https://github.com/ollama/ollama/releases/download/v0.5.5/ollama-linux-arm64"],
    sha256 = "",  # TODO: Get SHA256 from GitHub release
    downloaded_file_path = "ollama_bin",
    executable = True,
)

# Ruff linter/formatter — hermetic, platform-selecting (mac arm64 / linux x86_64).
# See tools/ruff.bzl: a single-platform pin broke commits on the Linux host.
ruff_extension = use_extension("//tools:ruff.bzl", "ruff_extension")
use_repo(ruff_extension, "ruff")
