# =============================================================================
# Visa Bulletin - Environment Variables
# =============================================================================
# Copy to .env and fill in values: cp .env.example .env
#
# Required variables are uncommented. Optional variables are commented out
# with their defaults shown.

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_NAME=visa_bulletin
DB_USER=visa_bulletin_user
DB_PASSWORD=CHANGEME

# DB_HOST duality:
#   - Host-based processes (Bazel scripts, cron, gunicorn on host): DB_HOST=localhost
#   - Docker containers use host.docker.internal (set in deployment/docker-compose.yml)
#   - The refresh pipeline auto-converts host.docker.internal -> localhost
#   - Set to localhost in .env; Docker overrides it per-container.
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# Django
# =============================================================================
# SECRET_KEY: Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be set in every environment. The default ("django-insecure-…") marks non-prod mode.
DJANGO_SECRET_KEY=CHANGEME

# Comma-separated list of hostnames/IPs Django will serve.
# Include: localhost, 127.0.0.1, instance public IP(s), domain name(s).
ALLOWED_HOSTS=localhost,127.0.0.1

# DEBUG is OFF by default. Set DEBUG=True ONLY for local development.
# Production .env MUST have DEBUG=False (or unset). settings.py hard-fails at boot
# if DEBUG=True and ALLOWED_HOSTS contains a production hostname (visa-bulletin.us).
DEBUG=True

# =============================================================================
# Redis / Cache
# =============================================================================
# Shared cache for employer profile and salary pages. Omit for LocMem (dev).
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# Analytics (optional)
# =============================================================================
# Full <script> tag for your analytics provider (GoatCounter, Umami, etc.).
# ANALYTICS_SCRIPT=<script data-goatcounter="https://yoursite.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>

# =============================================================================
# Docker / Deployment
# =============================================================================
# Docker image tag for docker-compose pull.
# IMAGE_TAG=latest

# Gunicorn worker count inside the container.
# WEB_CONCURRENCY=2

# =============================================================================
# Refresh Orchestrator (instance-rotation pipeline)
# =============================================================================
# Active instance (currently serving production traffic).
# REFRESH_ACTIVE_INSTANCE_NAME=VisaBulletin2GB
# REFRESH_ACTIVE_INSTANCE_IP=

# Inactive instance (pipeline target; becomes new prod after traffic switch).
# REFRESH_INACTIVE_INSTANCE_NAME=VisaBulletinStaging
# REFRESH_INACTIVE_INSTANCE_IP=

# This host's Lightsail instance name (used to detect if this is active/inactive).
# REFRESH_MY_INSTANCE_NAME=VisaBulletin2GB

# SSH config for connecting to the inactive host.
# REFRESH_SSH_USER=ubuntu
# REFRESH_SSH_KEY_PATH=/home/ubuntu/.ssh/lightsail_visa_bulletin
# REFRESH_SSH_TIMEOUT=14400

# Remote host paths.
# REFRESH_REMOTE_PROJECT_ROOT=/opt/visa_bulletin
# REFRESH_REMOTE_DB_NAME=visa_bulletin
# REFRESH_REMOTE_COMPOSE_FILE=

# Backup directory for checkpoints. Default: /var/backups/visa-bulletin or ./backups.
# REFRESH_BACKUP_DIR=

# Skip starting the inactive instance (assume it's already running).
# REFRESH_ASSUME_INACTIVE_RUNNING=false

# Stage log path for detailed step output.
# REFRESH_STAGE_LOG_PATH=/tmp/refresh_stage.log

# =============================================================================
# Traffic Switch (Lightsail static IP reassignment)
# =============================================================================
# Lightsail static IP name to reassign from old prod to new prod.
# REFRESH_STATIC_IP_NAME=

# Lightsail static IP name for staging (reassigned to old prod after switch).
# Required on the instance that runs the orchestrator (current prod). Get from: aws lightsail get-static-ips --region us-east-1
# REFRESH_STAGING_STATIC_IP_NAME=VisaBulletinStaging-ip

# =============================================================================
# HTTPS (certbot)
# =============================================================================
# Skip certbot HTTPS setup on new prod after traffic switch.
# REFRESH_SKIP_HTTPS_SETUP=false

# Comma-separated domains for certbot.
# REFRESH_HTTPS_DOMAINS=visa-bulletin.us,www.visa-bulletin.us

# Skip reassigning staging static IP to old prod after switch.
# REFRESH_SKIP_STAGING_IP_REASSIGN=false

# =============================================================================
# AWS (for Lightsail instance start/stop)
# =============================================================================
# Option A: Use an AWS CLI profile (configure with: aws configure --profile visa-bulletin-deploy)
# AWS_PROFILE=visa-bulletin-deploy

# Option B: Inline credentials (alternative to profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Lightsail region for API calls.
# REFRESH_AWS_REGION=us-east-1
